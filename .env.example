# Chave da API do YouTube (Google Cloud Console → YouTube Data API v3)
YOUTUBE_API_KEY=AIzaSy...

# ID do canal do YouTube da sua igreja (começa com UC...)
# Para encontrar: acesse o canal → Sobre → Compartilhar canal → Copiar ID do canal
YOUTUBE_CHANNEL_ID=UCxxxxxx...

# ID do grupo/canal de Avisos no WhatsApp (formato JID: número@g.us)
# Para encontrar: rode `node index.js --listar-grupos` e copie o ID correto
WHATSAPP_GROUP_NAME=120363xxxxxxxxx@g.us

# Fuso horário (não alterar se estiver no Brasil)
TZ=America/Sao_Paulo
